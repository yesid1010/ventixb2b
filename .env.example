# Envío del formulario de contacto con Brevo (igual que psico-panel).
# Copia este archivo como .env.local y configura las mismas variables en Vercel.
BREVO_API_KEY=
# Remitente: debe estar verificado en Brevo (Senders & IP → Senders / Domains)
BREVO_FROM_EMAIL=comercial@ventixb2b.com
BREVO_FROM_NAME=Web VentixB2B
# Opcional: a dónde llegan los mensajes (por defecto comercial@ventixb2b.com)
CONTACT_NOTIFICATIONS_EMAIL=

# Dominio público del sitio (para SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ventixb2b.com
